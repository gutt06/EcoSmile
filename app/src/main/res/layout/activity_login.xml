<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- ── Logo ───────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sou"
                android:textSize="36sp"
                android:textColor="#1A1A1A"
                android:fontFamily="@font/sf_pro"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="smile"
                android:textSize="36sp"
                android:textColor="#F97553"
                android:fontFamily="@font/sf_pro"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── Eyebrow label ──────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACESSAR PORTAL"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#317589"
            android:fontFamily="@font/sf_pro"
            android:letterSpacing="0.14"
            android:layout_marginBottom="4dp" />

        <!-- ── Headline ───────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minha área"
            android:textSize="36sp"
            android:textColor="#111111"
            android:fontFamily="@font/sf_pro"
            android:textStyle="bold"
            android:layout_marginBottom="36dp" />

        <!-- ── Campo E-mail ───────────────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E0E0E0"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="#FAFAFA"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#BBBBBB"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="seuemail@exemplo.com.br"
                android:textColorHint="#BBBBBB"
                android:textColor="#1A1A1A"
                android:inputType="textEmailAddress"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                android:paddingStart="4dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Campo Senha com toggle ─────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSenha"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E0E0E0"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="#FAFAFA"
            app:startIconDrawable="@android:drawable/ic_lock_lock"
            app:startIconTint="#BBBBBB"
            app:endIconMode="password_toggle"
            app:endIconTint="#BBBBBB"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Senha"
                android:textColorHint="#BBBBBB"
                android:textColor="#1A1A1A"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                android:paddingStart="4dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Esqueceu senha ─────────────────────────────────────── -->
        <TextView
            android:id="@+id/forgotPasswordTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Esqueceu sua senha?"
            android:textColor="#F97553"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/sf_pro"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginBottom="32dp" />

        <!-- ── Botão Entrar ───────────────────────────────────────── -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Entrar"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/sf_pro"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F97553"
            app:cornerRadius="28dp"
            android:elevation="0dp"
            android:layout_marginBottom="28dp" />

        <!-- ── Rodapé: não possui conta ──────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Não possui conta? "
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro" />

            <TextView
                android:id="@+id/registerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cadastre-se"
                android:textColor="#F97553"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- ── Termos de serviço ──────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ao prosseguir, concorda com os nossos Termos de Serviço e Política de Privacidade."
            android:textColor="#BBBBBB"
            android:textSize="11sp"
            android:fontFamily="@font/sf_pro"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>
</ScrollView>
