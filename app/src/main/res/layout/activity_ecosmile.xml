<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_ecosmile.xml  —  sousmile
    Header eco smile, card saldo, botões ação,
    card o que é EcoSmile, como preparar, onde descartar, histórico.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- ── Header: back + logo eco smile ─────────────────────── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/btnVoltarEco"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#111111"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="eco"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#317589"
                    android:fontFamily="@font/sf_pro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" smile"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#F97553"
                    android:fontFamily="@font/sf_pro" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ── Card Saldo ─────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#FFD4C4"
            app:cardBackgroundColor="#FFFFFF">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">

                <!-- Saldo à esquerda -->
                <LinearLayout
                    android:id="@+id/layoutSaldo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SEU SALDO ⓘ"
                        android:textSize="10sp"
                        android:textColor="#F97553"
                        android:textStyle="bold"
                        android:fontFamily="@font/sf_pro"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/txtSaldoPontos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textSize="52sp"
                            android:textColor="#F97553"
                            android:fontFamily="@font/sf_pro"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" pts"
                            android:textSize="18sp"
                            android:textColor="#F97553"
                            android:fontFamily="@font/sf_pro"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Ícone estrela à direita -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFECE6">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/btn_star_big_on"
                        app:tint="#F97553" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Botões de ação ─────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="28dp">

            <Button
                android:id="@+id/btnRegistrarDevolucao"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Registrar devolução"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F97553"
                app:cornerRadius="16dp"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btnAcessarLojinha"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Acessar lojinha"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                android:textColor="#111111"
                android:backgroundTint="#F2F2F2"
                app:cornerRadius="16dp"
                android:elevation="0dp" />
        </LinearLayout>

        <!-- ── Card: O que é a EcoSmile? ─────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#EAEAEA"
            app:cardBackgroundColor="#F8FAFA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O que é a EcoSmile?"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A EcoSmile é uma iniciativa que visa o descarte correto de seus alinhadores. Ao participar você ajuda o meio ambiente e ganha pontos!"
                    android:textSize="13.5sp"
                    android:textColor="#777777"
                    android:fontFamily="@font/sf_pro"
                    android:lineSpacingMultiplier="1.35"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btnEntendaImpacto"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Entenda nosso impacto"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/sf_pro"
                    android:textColor="#317589"
                    android:backgroundTint="#FFFFFF"
                    app:strokeColor="#317589"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="25dp"
                    android:elevation="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Como preparar para descarte? ──────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Como preparar para descarte?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seu alinhador precisa ser higienizado corretamente para descarte seguro."
            android:textSize="14sp"
            android:textColor="#777777"
            android:fontFamily="@font/sf_pro"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnVerPassoAPasso"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Ver passo a passo"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/sf_pro"
            android:textColor="#F97553"
            android:backgroundTint="#FFFFFF"
            app:strokeColor="#F97553"
            app:strokeWidth="1.5dp"
            app:cornerRadius="27dp"
            android:elevation="0dp"
            android:layout_marginBottom="32dp" />

        <!-- ── Onde posso descartar? ──────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Onde posso descartar?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Veja as opções de descarte nas nossas unidades mais próximas de você."
            android:textSize="14sp"
            android:textColor="#777777"
            android:fontFamily="@font/sf_pro"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="16dp" />

        <!-- Estado de carregamento -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPontosColetaCarregando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8FAFA"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carregando pontos de coleta..."
                android:textSize="13sp"
                android:textColor="#999999"
                android:fontFamily="@font/sf_pro"
                android:gravity="center"
                android:padding="28dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Estado vazio -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPontosColetaVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8FAFA"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhum ponto de coleta cadastrado ainda."
                android:textSize="13sp"
                android:textColor="#999999"
                android:fontFamily="@font/sf_pro"
                android:gravity="center"
                android:padding="28dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Container dinâmico para os pontos de coleta (preenchido via código) -->
        <LinearLayout
            android:id="@+id/containerPontosColeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <!-- ── Histórico de devoluções ────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Histórico de devoluções"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acompanhe os alinhadores que você já reciclou."
            android:textSize="14sp"
            android:textColor="#777777"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="16dp" />

        <!-- Estado de carregamento -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHistoricoCarregando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8FAFA"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carregando histórico..."
                android:textSize="13sp"
                android:textColor="#999999"
                android:fontFamily="@font/sf_pro"
                android:gravity="center"
                android:padding="28dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Estado vazio -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHistoricoVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8FAFA"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhuma devolução registrada ainda."
                android:textSize="13sp"
                android:textColor="#999999"
                android:fontFamily="@font/sf_pro"
                android:gravity="center"
                android:padding="28dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Container dinâmico para itens do histórico (preenchido via código) -->
        <LinearLayout
            android:id="@+id/containerHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
