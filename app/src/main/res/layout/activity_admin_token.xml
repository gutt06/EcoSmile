<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Botão Voltar -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/circle_gray"
            android:contentDescription="Voltar"
            android:layout_marginBottom="24dp" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gerar Token"
            android:textSize="22sp"
            android:textColor="#222222"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Campo ID do Tipo de Desconto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de desconto (ID)"
            android:textSize="14sp"
            android:textColor="#222222"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etTipoDescontoId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Tipo de desconto"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="number"
            android:layout_marginBottom="20dp" />

        <!-- Botão Gerar -->
        <Button
            android:id="@+id/btnGerar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Gerar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/bg_button_orange"
            android:layout_marginBottom="32dp" />

        <!-- Título Tokens Gerados -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tokens gerados"
            android:textSize="18sp"
            android:textColor="#222222"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Lista de Tokens (populada dinamicamente) -->
        <LinearLayout
            android:id="@+id/llTokensGerados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>