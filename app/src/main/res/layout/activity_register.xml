<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- ── Botão Voltar ───────────────────────────────────────── -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <!-- ── Logo ───────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sou"
                android:textSize="32sp"
                android:textColor="#1A1A1A"
                android:fontFamily="@font/sf_pro"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="smile"
                android:textSize="32sp"
                android:textColor="#F97553"
                android:fontFamily="@font/sf_pro"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── Headline ───────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preencha seus\ndados"
            android:textSize="36sp"
            android:textColor="#111111"
            android:fontFamily="@font/sf_pro"
            android:textStyle="bold"
            android:lineSpacingMultiplier="0.95"
            android:layout_marginBottom="32dp" />

        <!-- ── Campo Nome ─────────────────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNome"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E0E0E0"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="#FAFAFA"
            app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
            app:startIconTint="#BBBBBB"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Digite seu nome"
                android:textColorHint="#BBBBBB"
                android:textColor="#1A1A1A"
                android:inputType="textPersonName|textCapWords"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                android:paddingStart="4dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Campo E-mail ───────────────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmailCadastro"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E0E0E0"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="#FAFAFA"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#BBBBBB"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Digite seu email"
                android:textColorHint="#BBBBBB"
                android:textColor="#1A1A1A"
                android:inputType="textEmailAddress"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                android:paddingStart="4dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Campo Senha com toggle ─────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSenhaCadastro"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E0E0E0"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="#FAFAFA"
            app:startIconDrawable="@android:drawable/ic_lock_lock"
            app:startIconTint="#BBBBBB"
            app:endIconMode="password_toggle"
            app:endIconTint="#BBBBBB"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Digite sua senha"
                android:textColorHint="#BBBBBB"
                android:textColor="#1A1A1A"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                android:paddingStart="4dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Campo Confirmar Senha com toggle ───────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmarSenha"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E0E0E0"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="#FAFAFA"
            app:startIconDrawable="@android:drawable/ic_lock_lock"
            app:startIconTint="#BBBBBB"
            app:endIconMode="password_toggle"
            app:endIconTint="#BBBBBB"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmarSenhaEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Digite sua senha novamente"
                android:textColorHint="#BBBBBB"
                android:textColor="#1A1A1A"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                android:paddingStart="4dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Botão Cadastrar ────────────────────────────────────── -->
        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Cadastrar"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/sf_pro"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F97553"
            app:cornerRadius="28dp"
            android:elevation="0dp"
            android:layout_marginBottom="28dp" />

        <!-- ── Rodapé: já possui conta ────────────────────────────── -->
        <LinearLayout
            android:id="@+id/voltarLoginLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já possui uma conta? "
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entre"
                android:textColor="#F97553"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro" />
        </LinearLayout>

        <!-- ── Termos de serviço ──────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ao prosseguir, você concorda com os nossos Termos de Serviço e Política de Privacidade."
            android:textColor="#BBBBBB"
            android:textSize="11sp"
            android:fontFamily="@font/sf_pro"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>
</ScrollView>
