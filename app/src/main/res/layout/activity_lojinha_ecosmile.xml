<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btnVoltarLojinha"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#111111"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lojinha EcoSmile"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:fontFamily="@font/sf_pro"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Troque seus pontos virtuais por vantagens reais na clínica."
            android:textSize="15sp"
            android:textColor="#777777"
            android:fontFamily="@font/sf_pro"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA"
            app:cardBackgroundColor="#F8FAFA">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Seu Saldo Disponível:"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:fontFamily="@font/sf_pro"/>
                <TextView
                    android:id="@+id/txtSaldoLojinha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#F97553"
                    android:fontFamily="@font/sf_pro"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Indicador de carregamento dos itens da lojinha -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLojinhaCarregando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8FAFA"
            android:visibility="visible">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carregando itens da lojinha..."
                android:textSize="14sp"
                android:textColor="#999999"
                android:fontFamily="@font/sf_pro"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:padding="32dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Estado vazio: nenhum item disponível -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLojinhaVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8FAFA"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhum item disponível na lojinha por enquanto.\n\nVolte mais tarde para conferir novidades!"
                android:textSize="14sp"
                android:textColor="#999999"
                android:fontFamily="@font/sf_pro"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:padding="32dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Itens da lojinha (preenchidos dinamicamente) -->
        <LinearLayout
            android:id="@+id/containerLojinha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
