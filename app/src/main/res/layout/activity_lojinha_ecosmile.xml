<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btnVoltarLojinha"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#111111"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lojinha EcoSmile"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:fontFamily="@font/sf_pro"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Troque seus pontos virtuais por vantagens reais na clínica."
            android:textSize="15sp"
            android:textColor="#777777"
            android:fontFamily="@font/sf_pro"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA"
            app:cardBackgroundColor="#F8FAFA">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Seu Saldo Disponível:"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:fontFamily="@font/sf_pro"/>
                <TextView
                    android:id="@+id/txtSaldoLojinha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 pts"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#F97553"
                    android:fontFamily="@font/sf_pro"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#F0EFEC"
            app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desconto de 15%"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:fontFamily="@font/sf_pro"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aplicável na próxima manutenção."
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:layout_marginBottom="16dp"/>
                <Button
                    android:id="@+id/btnResgatarDesconto"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Resgatar por 10 pts"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:backgroundTint="#F97553"
                    app:cornerRadius="16dp"
                    android:elevation="0dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#F0EFEC"
            app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escova Ecológica Bamboo"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:fontFamily="@font/sf_pro"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brinde exclusivo sustentável."
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:layout_marginBottom="16dp"/>
                <Button
                    android:id="@+id/btnResgatarEscova"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Resgatar por 15 pts"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:backgroundTint="#F97553"
                    app:cornerRadius="16dp"
                    android:elevation="0dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
