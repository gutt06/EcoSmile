<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ForgotPasswordActivity">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/backButtonForgot"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_rounded"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recuperar Senha"
            android:textSize="28sp"
            android:textColor="#000000"
            android:fontFamily="@font/fonte"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Digite seu e-mail cadastrado e a nova senha que deseja utilizar."
            android:textSize="14sp"
            android:fontFamily="@font/fonte"
            android:textColor="#666666"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/forgotEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="E-mail cadastrado"
            android:inputType="textEmailAddress"
            android:background="@drawable/edit_text_rounded"
            android:paddingStart="20dp"
            android:fontFamily="@font/fonte"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/newPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nova Senha"
            android:inputType="textPassword"
            android:background="@drawable/edit_text_rounded"
            android:paddingStart="20dp"
            android:fontFamily="@font/fonte"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnUpdatePassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Atualizar Senha"
            android:backgroundTint="@color/soulsmile_orange"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/fonte"
            android:textAllCaps="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>