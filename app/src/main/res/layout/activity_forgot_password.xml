<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- ── Botão Voltar ───────────────────────────────────────── -->
        <ImageButton
            android:id="@+id/backButtonForgot"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <!-- Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sou"
                android:textSize="36sp"
                android:textColor="#222222"
                android:fontFamily="@font/sf_pro"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="smile"
                android:textSize="36sp"
                android:textColor="#F97553"
                android:fontFamily="@font/sf_pro"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Section label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECUPERAÇÃO DE ACESSO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#317589"
            android:fontFamily="@font/sf_pro"
            android:letterSpacing="0.12"
            android:layout_marginBottom="6dp" />

        <!-- Headline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recuperar senha"
            android:textSize="34sp"
            android:textColor="#111111"
            android:fontFamily="@font/sf_pro"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Descrição -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Digite o seu e-mail cadastrado e a nova senha que deseja utilizar para redefinir seu acesso com segurança."
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:fontFamily="@font/sf_pro"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="36dp" />

        <!-- E-mail label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-MAIL CADASTRADO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#ABABAB"
            android:fontFamily="@font/sf_pro"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp" />

        <!-- E-mail input -->
        <EditText
            android:id="@+id/forgotEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_premium"
            android:hint="seuemail@exemplo.com"
            android:textColorHint="#BBBBBB"
            android:textColor="#1A1A1A"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="15sp"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="20dp" />

        <!-- Nova senha label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOVA SENHA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#ABABAB"
            android:fontFamily="@font/sf_pro"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp" />

        <!-- Nova senha input -->
        <EditText
            android:id="@+id/newPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Digite a nova senha"
            android:textColorHint="#BBBBBB"
            android:textColor="#1A1A1A"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="15sp"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="36dp" />

        <!-- Botão Redefinir -->
        <Button
            android:id="@+id/btnUpdatePassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Redefinir senha"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/sf_pro"
            android:backgroundTint="#F97553"
            app:cornerRadius="28dp"
            android:elevation="0dp"
            android:layout_marginBottom="24dp" />

        <!-- Rodapé -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lembrou a senha? "
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:fontFamily="@font/sf_pro" />

            <TextView
                android:id="@+id/voltarLoginTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voltar ao login"
                android:textColor="#F97553"
                android:textSize="13sp"
                android:fontFamily="@font/sf_pro"
                android:textStyle="bold"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
