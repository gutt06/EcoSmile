<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#333333"
                android:background="@drawable/bg_circle_gray"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Criar desconto"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:fontFamily="@font/sf_pro" />

        </RelativeLayout>

        <!-- Descrição -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastre um novo desconto para ser exibido na Lojinha EcoSmile e resgatado pelos usuários com pontos."
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:fontFamily="@font/sf_pro"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="28dp" />

        <!-- Campo Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TÍTULO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#ABABAB"
            android:fontFamily="@font/sf_pro"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Ex: Desconto de 15% no Carrefour"
            android:textColorHint="#BBBBBB"
            android:textColor="#1A1A1A"
            android:inputType="text"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="15sp"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="20dp" />

        <!-- Campo Descrição -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESCRIÇÃO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#ABABAB"
            android:fontFamily="@font/sf_pro"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etDescricao"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Descreva as condições do desconto (opcional)"
            android:textColorHint="#BBBBBB"
            android:textColor="#1A1A1A"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top|start"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textSize="15sp"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="20dp" />

        <!-- Campo Valor Desconto -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VALOR DESCONTO (%)"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#ABABAB"
            android:fontFamily="@font/sf_pro"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etValorDesconto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Ex: 15"
            android:textColorHint="#BBBBBB"
            android:textColor="#1A1A1A"
            android:inputType="numberDecimal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="15sp"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="20dp" />

        <!-- Campo Custo em Pontos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CUSTO (PONTOS)"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#ABABAB"
            android:fontFamily="@font/sf_pro"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etCustoPontos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Ex: 10"
            android:textColorHint="#BBBBBB"
            android:textColor="#1A1A1A"
            android:inputType="number"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="15sp"
            android:fontFamily="@font/sf_pro"
            android:layout_marginBottom="36dp" />

        <!-- Botão Adicionar -->
        <Button
            android:id="@+id/btnAdicionar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Adicionar à Lojinha"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/sf_pro"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F5A623"
            app:cornerRadius="28dp"
            android:elevation="0dp" />

    </LinearLayout>
</ScrollView>
