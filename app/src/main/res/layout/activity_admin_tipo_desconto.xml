<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Botão Voltar -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/circle_gray"
            android:contentDescription="Voltar"
            android:layout_marginBottom="24dp" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Criar tipo de desconto"
            android:textSize="22sp"
            android:textColor="#222222"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Campo Tipo de Desconto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de desconto"
            android:textSize="14sp"
            android:textColor="#222222"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etDescricao"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Tipo de desconto"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="text"
            android:layout_marginBottom="20dp" />

        <!-- Campo Data de Expiração -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data de expiração"
            android:textSize="14sp"
            android:textColor="#222222"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etExpira"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="AAAA-MM-DD"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="date"
            android:layout_marginBottom="20dp" />

        <!-- Campo Valor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor (%)"
            android:textSize="14sp"
            android:textColor="#222222"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etValor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Digite o valor do desconto"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="number"
            android:layout_marginBottom="32dp" />

        <!-- Botão Criar -->
        <Button
            android:id="@+id/btnCriar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Criar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/bg_button_orange" />

    </LinearLayout>
</ScrollView>